# ==============================================================
# VR-BCI Project .gitignore
# ==============================================================

# --------------------------------------------------------------
# Python 編譯快取 (Generated by Python runtime)
# --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# --------------------------------------------------------------
# Python 套件管理 / 虛擬環境
# --------------------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/
*.egg
.eggs/

# --------------------------------------------------------------
# 執行時期產生的 Log 檔 (Generated by main_start.py tee_log)
# 格式: log_YYYYMMDD_HHMMSS.txt
# --------------------------------------------------------------
log_*.txt
*.log

# --------------------------------------------------------------
# EEG 訓練過程暫存模型 (Training temp checkpoints)
# python/main/EEG/checkpoints/ — 每次訓練覆蓋的中間權重
# 注意：用 /** 而非 / 結尾，這樣 .gitkeep 仍可被追蹤
# --------------------------------------------------------------
python/main/EEG/checkpoints/**
python/offline_simulation/EEG/**
python/offline_simulation/checkpoints/**

# --------------------------------------------------------------
# 執行時期 Real-time 資料輸出 (Runtime data output)
# python/main/real_time_data/ — eeg_record.csv, data.pt, run*/
# --------------------------------------------------------------
python/main/real_time_data/**

# 保留空目錄結構 (.gitkeep 例外，讓目錄骨架保留在 repo 中)
!python/main/EEG/checkpoints/.gitkeep
!python/main/EEG/checkpoint_main/.gitkeep
!python/main/real_time_data/.gitkeep

# --------------------------------------------------------------
# 大型模型權重檔 (Large model weight files)
# 注意：若 checkpoint_main/ 內的 *_random.pth 是「預建」基底模型
# 且需要隨 repo 一起保存，請將此段移除或縮小範圍。
# 目前設定：忽略所有 .pth，但保留 checkpoint_main/ 結構 (用 .gitkeep)
# --------------------------------------------------------------
*.pth
*.pt

# 例外：若特定 .pth 需要追蹤，可用 ! 解除忽略，例如：
# !python/main/EEG/checkpoint_main/model.pth

# --------------------------------------------------------------
# 資料與結果檔案 (Data & result files — 通常不入 repo)
# --------------------------------------------------------------
*.csv
*.npy
*.npz
*.h5
*.hdf5
*.mat

# --------------------------------------------------------------
# Jupyter Notebook 暫存
# --------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# --------------------------------------------------------------
# 作業系統產生的檔案
# --------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# --------------------------------------------------------------
# 編輯器 / IDE 設定
# --------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --------------------------------------------------------------
# 測試與覆蓋率報告
# --------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
